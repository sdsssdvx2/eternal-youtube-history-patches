{
  "manifest_version": 3,
  "name": "Eternal YouTube History",
  "version": "0.10.4",
  "description": "Ultra-light YouTube client for a Cloudflare D1 central watch ledger, page-scoped watched-card controls, and transactional Watch Later cleanup with undo.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "watch-later-safety-main.js",
        "watch-later-core.js",
        "watch-later-safe-main.js",
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "watch-later-core.js",
        "watch-later-safe-core.js",
        "content.js",
        "surface-profiles.js",
        "pc-ui-hotfix.js",
        "watch-later-safe.js",
        "maintenance.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eternal YouTube History"
  },
  "options_page": "options.html"
}
